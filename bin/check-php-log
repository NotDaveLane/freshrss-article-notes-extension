#!/usr/bin/env bash
# Fail on PHP diagnostics (warnings, notices, deprecations, errors) caused by ArticleNotes in the dev instance.
#   bin/check-php-log [--since TIME]   scan the freshrss container log (since TIME, e.g. 2026-10-19T21:00:00Z)
#   bin/check-php-log --stdin          scan a log given on standard input
# PHP writes its diagnostics through Apache to the container log (FreshRSS's data/users/*/log.txt only receive
# FreshRSS's own messages); the dev image tags each with its request ("[uri /i/?c=…]", docker/apache-error-log.conf).
# A diagnostic counts when it comes from xExtension-ArticleNotes/ (file or stack trace) or from a request to the
# extension's pages or API (c=ArticleNotes, /api/misc.php/ArticleNotes). Other diagnostics are unrelated to the
# extension: they are listed as ignored, but do not fail. bin/ci runs this after the end-to-end suite.
# Exit status: 0 clean, 1 diagnostics found, 2 usage error or the log could not be read.
set -uo pipefail

# Known diagnostics that are not the extension's fault although they match the rules above (extended regular
# expressions, matched against the whole log line). Document why for each entry. Currently none.
ALLOW_LIST=()

mode=docker since=''
while [ $# -gt 0 ]; do
	case "$1" in
		--stdin) mode=stdin ;;
		--since) since="${2:-}"; shift ;;
		-h|--help) sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
		*) echo "error: unknown option: $1 (see bin/check-php-log --help)" >&2; exit 2 ;;
	esac
	shift
done

if [ "$mode" = stdin ]; then
	log="$(cat)"
else
	source "$(dirname "${BASH_SOURCE[0]}")/lib-common.sh"
	log="$(docker compose logs --no-color --no-log-prefix ${since:+--since "$since"} freshrss 2>&1)" \
		|| { echo "error: could not read the freshrss container log" >&2; exit 2; }
fi

diagnostic='PHP (Warning|Notice|Deprecated|Fatal error|Parse error|Recoverable fatal error|Strict Standards):'
extension='xExtension-ArticleNotes/|\[uri [^]]*([?&]c=ArticleNotes([&#]|\]|$)|/api/misc\.php/ArticleNotes)'
found=() ignored=()
while IFS= read -r line; do
	[[ "$line" =~ $diagnostic ]] || continue
	for allowed in "${ALLOW_LIST[@]}"; do
		[[ "$line" =~ $allowed ]] && continue 2
	done
	if [[ "$line" =~ $extension ]]; then found+=("$line"); else ignored+=("$line"); fi
done <<< "$log"

if [ "${#ignored[@]}" -gt 0 ]; then
	echo "PHP diagnostics unrelated to ArticleNotes (ignored):"
	printf '  %s\n' "${ignored[@]}"
fi
if [ "${#found[@]}" -gt 0 ]; then
	echo "PHP diagnostics caused by ArticleNotes (fix them, do not hide them):"
	printf '  %s\n' "${found[@]}"
	exit 1
fi
echo 'No PHP diagnostics from ArticleNotes.'
