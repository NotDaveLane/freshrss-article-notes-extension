#!/usr/bin/env bash
# Full suite, run from the host (everything executes in containers):
#   PHP_CodeSniffer -> PHPStan -> ESLint -> PHPUnit with coverage (coverage/index.html) -> Playwright (with the
#   anchoring library's JavaScript coverage in coverage/js/index.html).
#   bin/ci            SQLite only (fast)
#   bin/ci --all-dbs  also run the integration suite against MariaDB and PostgreSQL
#   bin/ci --compat   version and database matrix: `bin/ci --all-dbs` once per FreshRSS version in
#                     COMPAT_VERSIONS (default "1.27.1 1.30.1": oldest supported line and the default),
#                     each in its own throwaway compose project; the dev instance is not touched.
#                     Linting runs on the default version only (APIs and FreshRSS's phpcs rules differ).
#   bin/ci --no-lint  skip phpcs, PHPStan and ESLint
# Prerequisite (except --compat): docker compose up --build -d --wait
# Exits non-zero if any step failed; every step runs even after a failure.
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib-common.sh"

all_dbs=0 compat=0 lint=1
for arg in "$@"; do
	case "$arg" in
		--all-dbs) all_dbs=1 ;;
		--compat) compat=1 ;;
		--no-lint) lint=0 ;;
		-h|--help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
		*) echo "error: unknown option: $arg (see bin/ci --help)" >&2; exit 2 ;;
	esac
done

if [ "$compat" = 1 ]; then
	failed=0 summary=''
	default_version="$(sed -n 's/.*FRESHRSS_VERSION:-\([0-9.]*\)}.*/\1/p' docker-compose.yml | head -n 1)"
	for version in ${COMPAT_VERSIONS:-1.27.1 $default_version}; do
		echo; echo "##### FreshRSS $version #####"
		export FRESHRSS_VERSION="$version" FRESHRSS_PORT=0 COMPOSE_PROJECT_NAME="articlenotes-compat-${version//./-}"
		if docker compose up --build -d --wait >&2; then
			if [ "$version" = "$default_version" ]; then "$0" --all-dbs; else "$0" --all-dbs --no-lint; fi
			result=$?
		else
			echo "error: FreshRSS $version did not start" >&2; result=1
		fi
		docker compose --profile tools --profile db-matrix down -v --remove-orphans >/dev/null 2>&1
		if [ "$result" = 0 ]; then summary+="  PASS FreshRSS $version"$'\n'; else summary+="  FAIL FreshRSS $version"$'\n'; failed=1; fi
	done
	echo; echo '=== compatibility summary ==='; printf '%s' "$summary"
	if [ "$failed" = 0 ]; then echo 'bin/ci --compat: OK'; else echo 'bin/ci --compat: FAILED'; fi
	exit "$failed"
fi

require_stack
docker compose build dev >&2 || { echo 'error: could not build the dev image' >&2; exit 2; }
ensure_vendor || { echo 'error: composer install failed' >&2; exit 2; }

declare -a names=() results=()
step() {
	local name="$1"; shift
	echo; echo "=== $name ==="
	if "$@"; then results+=("PASS"); else results+=("FAIL"); fi
	names+=("$name")
}

# phpunit_db <engine> [--coverage]: whole suite with coverage, else the integration suite only.
phpunit_db() {
	if [ "${2:-}" = --coverage ]; then TEST_DB="$1" dev vendor/bin/phpunit
	else TEST_DB="$1" dev vendor/bin/phpunit --testsuite integration --no-coverage; fi
}

if [ "$lint" = 1 ]; then
	step 'phpcs' dev vendor/bin/phpcs
	step 'phpstan' dev vendor/bin/phpstan analyse --no-progress --memory-limit=1G
	step 'eslint' eslint_js
fi
rm -rf coverage
step 'phpunit (sqlite, coverage)' phpunit_db sqlite --coverage
if [ "$all_dbs" = 1 ]; then
	if docker compose --profile db-matrix up -d --wait mariadb postgres >&2; then
		step 'phpunit integration (mariadb)' phpunit_db mariadb
		step 'phpunit integration (postgres)' phpunit_db postgres
	else
		names+=('db-matrix services'); results+=("FAIL")
	fi
	docker compose --profile db-matrix rm -sf mariadb postgres >/dev/null 2>&1
fi
step 'e2e (playwright)' bin/e2e

echo; echo '=== summary ==='
failed=0
for i in "${!names[@]}"; do
	printf '  %-4s %s\n' "${results[$i]}" "${names[$i]}"
	[ "${results[$i]}" = PASS ] || failed=1
done
[ -f coverage/index.html ] && echo "  coverage report: $ROOT/coverage/index.html"
[ -f coverage/js/index.html ] && echo "  JavaScript coverage report: $ROOT/coverage/js/index.html"
if [ "$failed" = 0 ]; then echo 'bin/ci: OK'; else echo 'bin/ci: FAILED'; fi
exit "$failed"
