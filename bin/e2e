#!/usr/bin/env bash
# Run Playwright specs against the running dev stack (http://freshrss on the compose network).
#   bin/e2e                         all specs
#   bin/e2e specs/smoke.spec.ts     one spec
# A throwaway user is created for the run via FreshRSS's CLI, subscribed to the local fixture
# feed (http://fixtures/feed.xml), exported as E2E_USER/E2E_PASSWORD, and deleted afterwards.
set -uo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/lib-common.sh"
require_stack

E2E_USER="e2e$(date +%s)$RANDOM"
E2E_PASSWORD="e2e-$(head -c 12 /dev/urandom | od -An -tx1 | tr -d ' \n')"
fx() { docker compose exec -T -u www-data freshrss "$@"; }

cleanup() { fx php cli/delete-user.php --user "$E2E_USER" >/dev/null 2>&1; }
trap cleanup EXIT

fx php cli/create-user.php --user "$E2E_USER" --password "$E2E_PASSWORD" --language en --no-default-feeds >/dev/null || exit 1
fx sh -c "cat > /tmp/$E2E_USER.opml" < tests/fixtures/fixture-feed.opml || exit 1
fx php cli/import-for-user.php --user "$E2E_USER" --filename "/tmp/$E2E_USER.opml" >/dev/null || exit 1
fx rm -f "/tmp/$E2E_USER.opml"
fx php cli/actualize-user.php --user "$E2E_USER" >/dev/null || exit 1

docker compose run --rm --no-deps -T \
	-e E2E_USER="$E2E_USER" -e E2E_PASSWORD="$E2E_PASSWORD" \
	e2e sh -c 'npm ci --no-audit --no-fund --loglevel=error && npx playwright test "$@"' sh "$@"
