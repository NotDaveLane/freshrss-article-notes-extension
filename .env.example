# DEVELOPMENT ONLY - these credentials are public. Never use them on a real instance.
# Copy to .env to override; compose works without it (same defaults).
FRESHRSS_PORT=8080
FRESHRSS_VERSION=1.30.1
FRESHRSS_DEV_USER=admin
FRESHRSS_DEV_PASSWORD=freshrss-dev-password
FRESHRSS_DEV_API_PASSWORD=freshrss-dev-api
